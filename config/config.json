{
  "include_forks": false,
  "include_archived": false,
  "exclude": [],
  "min_rate_remaining": 400,
  "sleep_between_calls": 0.1,
  "keep_source_days": 90,
  "cadence": {
    "active_days": 1,
    "idle_days": 3,
    "dormant_days": 7,
    "dormant_after_idle_days": 45
  },
  "site_url": "https://musman550.github.io/github-traffic-analytics-dashboard/",
  "site_name": "GitHub Traffic Analytics Dashboard",
  "repo_full_name": "musman550/github-traffic-analytics-dashboard",
  "extra_links": [],
  "verification": {
    "google": "",
    "bing": ""
  },
  "notifications": {
    "issues": true,
    "telegram": true
  },
  "version": "5.1.0",
  "optimizer": {
    "enabled": true,
    "max_repos_per_run": 10,
    "cooldown_days": 21,
    "evaluate_after_days": 14,
    "min_baseline_views": 20,
    "drop_threshold": 0.3,
    "auto_merge_days": 3,
    "readme_declined_cooldown_days": 90,
    "exclude": [
      "musman550",
      "github-traffic-analytics-dashboard",
      "musfira-ai-repo-bot"
    ],
    "generated_prefixes": [
      "musfira-ai-"
    ],
    "generated_readme": false,
    "description_policy": "improve_if_weak",
    "max_topics": 12,
    "branch_prefix": "auto-seo/",
    "block_start": "<!-- AUTO-SEO:START -->",
    "block_end": "<!-- AUTO-SEO:END -->",
    "use_judge": true,
    "remove_junk_topics": true,
    "generated_max_new_topics": 0,
    "rules_cooldown_days": 3
  },
  "ai": {
    "allow_closed_models": false,
    "timeout": 45,
    "order": [
      "groq",
      "cerebras",
      "github-models",
      "ovhcloud",
      "pollinations",
      "openrouter",
      "huggingface",
      "mistral",
      "cloudflare",
      "gemini"
    ],
    "providers": {},
    "anon_enabled": true
  },
  "root_site": true
}
